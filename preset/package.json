{
  "name": "@GJY-cmd/dsh-cn-dict-preset",
  "version": "0.1.0",
  "description": "DSH「汉语词典」模式：标准工具集 + 本地汉语词典能力（dict_lookup）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
